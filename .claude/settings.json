{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(node .quality/bin/qg.mjs status)",
      "Bash(node .quality/bin/qg.mjs metrics)",
      "Bash(node .quality/bin/qg.mjs init:*)",
      "Bash(node .quality/bin/qg.mjs tier:*)",
      "Bash(node .quality/bin/qg.mjs stage)",
      "Bash(node .quality/bin/qg.mjs checks)",
      "Bash(node .quality/bin/qg.mjs escalate:*)",
      "Bash(node .quality/bin/qg.mjs gate)",
      "Bash(node .quality/bin/qg.mjs finalize)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier --check:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run bench:*)",
      "Bash(npm audit:*)",
      "Bash(semgrep scan:*)",
      "Bash(gitleaks protect:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(dart tool/check_lib_size.dart:*)",
      "Bash(dart analyze:*)",
      "Bash(gh:*)",
      "Bash(git add:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(node .quality/bin/qg.mjs req:*)",
      "Bash(node .quality/bin/qg.mjs abort:*)",
      "Bash(node .quality/bin/qg.mjs design:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(yarn add:*)",
      "Bash(yarn remove:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./.secure/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git commit --amend:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git config:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.quality/bin/qg.mjs\" hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.quality/bin/qg.mjs\" hook pre-tool",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task|SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.quality/bin/qg.mjs\" hook post-tool",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.quality/bin/qg.mjs\" hook subagent-start",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.quality/bin/qg.mjs\" hook subagent-stop",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
